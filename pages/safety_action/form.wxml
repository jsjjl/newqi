<view class="page">
  <view class="form-group">
    <view class="label">任务名称</view>
    <input class="input" value="{{taskName}}" disabled="true" style="color:#999;" />
  </view>

  <view class="form-group">
    <view class="label"><text class="required">*</text>检查区域/位置</view>
    <input class="input" placeholder="请输入检查的区域或位置" model:value="{{location}}" />
  </view>

  <view class="form-group">
    <view class="label"><text class="required">*</text>排查情况描述</view>
    <textarea class="textarea" placeholder="请详细描述安全行动日排查情况、发现的问题等..." model:value="{{description}}" maxlength="500"></textarea>
  </view>
  
  <view class="form-group">
    <view class="label">现场照片 <text class="sub-title">(最多5张)</text></view>
    <view class="image-list">
      <block wx:for="{{img_arr}}" wx:key="*this">
        <view class="image-item">
          <image src="{{item}}" mode="aspectFill" bindtap="previewImg" data-index="{{index}}" />
          <view class="delete-btn" bindtap="deleteImg" data-index="{{index}}">×</view>
        </view>
      </block>
      <view class="add-btn" bindtap="addImg" wx:if="{{img_arr.length < 5}}">
        <text class="add-icon">+</text>
        <text class="add-text">添加照片</text>
      </view>
    </view>
  </view>

  <view class="submit-btn" bindtap="submit">确认提交报表</view>
</view>
<danger-btn />