
page {
  background: var(--bg-color, #f4f6f9);
}
.main {
  width: 100%;
  box-sizing: border-box;
}
.grid-item {
  width: 28%;
  padding: 30rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: var(--border-radius-lg);
}
.icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.icon-wrap image {
  width: 40rpx;
  height: 40rpx;
}
.item-text {
  font-size: 24rpx;
  color: var(--text-main);
  font-weight: 500;
  text-align: center;
}
.list-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.list-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-radius: var(--border-radius-lg);
}
.item-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
}
.item-title {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-main);
  font-weight: 500;
}
.arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.3;
}