

.title{ width: 100%; height: auto; display: block; float: left; margin: 20rpx 0 10rpx; padding:0 30rpx; box-sizing: border-box;}
.title image{ width: 55rpx; height: 55rpx; display: block; float: left; margin: 0 20rpx 0 0;}
.title  span{ width: auto; height: auto; display: block; float: left; line-height: 55rpx; font-size: 27rpx; color: #2f2f2f;}

.bj{ background-image: -moz-linear-gradient( 90deg, rgb(255,255,255) 0%, rgb(245,252,234) 80%, rgb(230,250,198) 100%);
    background-image: -webkit-linear-gradient( 90deg, rgb(255,255,255) 0%, rgb(245,252,234) 80%, rgb(230,250,198) 100%);
    background-image: -ms-linear-gradient( 90deg, rgb(255,255,255) 0%, rgb(245,252,234) 80%, rgb(230,250,198) 100%);height: 100%; position: fixed; width: 100%; width: 100%; top: 0; left: 0; z-index: -1; }

.ant{ width: 42.5%; height: 220rpx; display: block; float: left; margin: 20rpx 0 20rpx 5%; padding: 20rpx 30rpx; box-sizing: border-box;border: 1px solid #1677ff; border-radius: 20rpx; background: #fff;box-shadow: 0px 12rpx 18rpx 2rpx rgba(1, 198, 135, 0.1);}
.antl{ width: 60rpx; height: 60rpx; display: block; float: left; margin: 20rpx 0 0 25rpx;}
.ant span{ width: 90%; height: 80rpx; line-height: 40rpx; margin:20rpx 0 0 20rpx; display: block; float: left;}
.antr{ width: 50rpx; height: 50rpx; display: none; float: right; margin: 15rpx 0rpx 0 0; opacity: .5;}

.boxs{ width:680rpx; height: auto; display: block; float: left;  border-radius: 30rpx;
    /* background-image: -moz-linear-gradient( -1deg, rgb(177,239,192) 0%, rgb(1,197,134) 100%);
    background-image: -webkit-linear-gradient( -1deg, rgb(177,239,192) 0%, rgb(1,197,134) 100%);
    background-image: -ms-linear-gradient( -1deg, rgb(177,239,192) 0%, rgb(1,197,134) 100%); */
    background: #1677ff;
    box-shadow: 0px 12rpx 18rpx 2rpx rgba(22, 119, 255, 0.25);
    margin: 30rpx 35rpx;
    padding-bottom: 20rpx;
}
.boxs .title span{ color: #fff;}
.boxs_f{ width: 100%;  height: 100%; display: block; float: left; color: #fff; }
.boxs_f p{ width:50%; height: auto; display: block; float: left; text-align: center; margin: 30rpx 0 30rpx; padding: 0 10rpx; border-right: 1px solid rgba(255, 255, 255, 0.5); box-sizing: border-box; }
.boxs_f p:nth-child(2n){border: 0;}
.boxs_f p span{ width: 100%; height: auto; display: block; float: left; text-align: center;  font-size: 50rpx; }
.boxs_f p em{ width: 100%; height: auto; display: block; float: left; text-align: center;  font-size: 25rpx; font-style: normal;}

.fboxs{  width:680rpx; height: auto; display: block; float: left;margin: 0rpx 35rpx 30rpx;}

.fbox{  width:100%; height: auto; display: block; float: left;margin: 0 0 15rpx; padding: 0 0 15rpx; border-bottom: 1px solid rgba(0, 0, 0, 0.2);}

.fbox p{ width:100%; height: auto; display: block; float: left; margin: 10rpx 0 5rpx;}
.fbox  span{ width: 30%; height:  auto; display: block; float: left; font-size: 27rpx; color: #2f2f2f;}
.fbox   em{font-style: normal; width: 65%; height:  auto; display: block; float: right; text-align: right; font-size: 27rpx; color: #2f2f2f;}

.tl{width:auto; height: auto; display: block; float: right;}
.tl p{width:auto; height: auto; display: block; float: right;}
.tl p i{ width: 20rpx; height: 20rpx; display: inline-block; border-radius: 20rpx; background: #1677ff; margin: 20rpx 10rpx 0 20rpx; float: left;}


