<view class="page" style="padding: 20rpx; min-height: 100vh; background: var(--bg-color); padding-bottom: 120rpx;">

<view class="modern-card" style="margin-bottom: 20rpx; padding: 30rpx;">
  <view class="top flex-between" style="display: flex; justify-content: space-between; align-items: center;">
      <span style="font-size: 30rpx; font-weight: 500; color: var(--text-main);">匿名上报</span>
      <switch checked="{{isAnonymous}}" bindchange="switch1Change" color="#1568EA"/>
  </view>
</view>

<block wx:if="{{isAnonymous==false}}">
<view class="modern-card" style="margin-bottom: 20rpx; padding: 10rpx 30rpx;">
  <view class="top" style="margin-top: 20rpx;">
      <p style="font-size: 28rpx; color: var(--text-sub);">姓名</p>
  </view>
  <view class="xlk" style="border-bottom: 1rpx solid var(--border-color); padding: 10rpx 0;">
          <input class="xlki" type="text" placeholder="请输入姓名" bindinput="_name" placeholder-class="placeholder" value="{{name}}" style="font-size: 30rpx; color: var(--text-main);" />
  </view>

  <view class="top" style="margin-top: 20rpx;">
      <p style="font-size: 28rpx; color: var(--text-sub);">工号</p>
  </view>
  <view class="xlk" style="border-bottom: 1rpx solid var(--border-color); padding: 10rpx 0;">
          <input class="xlki" type="text" placeholder="请输入工号" bindinput="_empno" placeholder-class="placeholder" value="{{empno}}" style="font-size: 30rpx; color: var(--text-main);" />
  </view>

  <view class="top" style="margin-top: 20rpx;">
      <p style="font-size: 28rpx; color: var(--text-sub);">联系方式</p>
  </view>
  <view class="xlk" style="padding: 10rpx 0;">
          <input class="xlki" type="text" placeholder="请输入联系方式" bindinput="_phone" placeholder-class="placeholder" value="{{phone}}" style="font-size: 30rpx; color: var(--text-main);" />
  </view>
</view>
</block>

<view class="modern-card" style="margin-bottom: 20rpx; padding: 10rpx 30rpx 30rpx;">
  <view class="title" style="display: flex; align-items: center; margin: 20rpx 0 10rpx;">
      <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/map.png" mode="widthFix" style="width: 32rpx; height: 32rpx; margin-right: 12rpx;" />
      <p style="font-size: 30rpx; font-weight: 500; color: var(--text-main);">上报位置 <text style="color: #ff4d4f;">*</text></p>
  </view>
  <view class="xlk" style="background: #f9fafb; padding: 20rpx; border-radius: 12rpx;">
          <input class="xlki" type="text" placeholder="请输入详细的上报位置" bindinput="bindKeyInput" placeholder-class="placeholder" value="{{location}}" style="font-size: 30rpx;" />
  </view>

  <view class="title" style="display: flex; align-items: center; margin: 30rpx 0 10rpx;">
      <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/new/s3_4.svg" mode="widthFix" style="width: 32rpx; height: 32rpx; margin-right: 12rpx;" />
      <p style="font-size: 30rpx; font-weight: 500; color: var(--text-main);">上报内容 <text style="color: #ff4d4f;">*</text></p>
  </view>
  <view class="bz">
       <textarea bindblur="bindTextAreaBlur" class="bzb" placeholder="请详细描述隐患内容..." style="width: 98%; height: 200rpx; background: #f9fafb; padding: 20rpx; border-radius: 12rpx; font-size: 28rpx; box-sizing: border-box;" />
  </view>
</view>

<view class="modern-card" style="margin-bottom: 20rpx; padding: 30rpx;">
  <view class="title" style="display: flex; align-items: center; margin-bottom: 20rpx; margin: 0 0 20rpx;">
      <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/img.png" mode="widthFix" style="width: 32rpx; height: 32rpx; margin-right: 12rpx;" />
      <p style="font-size: 30rpx; font-weight: 500; color: var(--text-main);">现场照片 / 视频</p>
  </view>

  <view class="tp" style="padding: 0; display: flex; flex-wrap: wrap;">
      <block wx:for='{{img_arr}}' wx:key='index' wx:for-item='item'>
              <view class="tpt" style="width: 150rpx; height: 150rpx; margin-right: 20rpx; margin-bottom: 20rpx; position: relative;">
                  <image class="tptimg" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImg" style="width: 100%; height: 100%; border-radius: 12rpx;"></image>
                  <image class="del" src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/d.png" bindtap="deleteImg" data-id="{{item}}" mode="aspectFill" style="position: absolute; top: -12rpx; right: -12rpx; width: 40rpx; height: 40rpx;"></image>
              </view> 
      </block>
      
      <view wx:if="{{video}}" class="tpt" style="width: 150rpx; height: 150rpx; margin-right: 20rpx; margin-bottom: 20rpx; position: relative;">
          <video class="tptimg" src="{{video}}" show-center-play-btn="{{false}}" controls="{{false}}" bindtap="previewVideo" style="width: 100%; height: 100%; border-radius: 12rpx;"></video>
          <view class="video-play-icon" bindtap="previewVideo"></view>
          <image class="del" src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/d.png" bindtap="deleteVideo" mode="aspectFill" style="position: absolute; top: -12rpx; right: -12rpx; width: 40rpx; height: 40rpx;"></image>
      </view>

      <view class="tpadd" bindtap="addimg" style="width: 150rpx; height: 150rpx; background: #f9fafb; border: 2rpx dashed #d1d5db; border-radius: 12rpx; display: flex; flex-direction: column; justify-content: center; align-items: center; margin-bottom: 20rpx;">
          <p style="font-size: 40rpx; color: #9ca3af; line-height: 1;">+</p>
          <span style="font-size: 24rpx; color: #9ca3af; margin-top: 8rpx;">添加照片</span>
      </view>
      <view wx:if="{{!video}}" class="tpadd" bindtap="addVideo" style="width: 150rpx; height: 150rpx; background: #f9fafb; border: 2rpx dashed #d1d5db; border-radius: 12rpx; display: flex; flex-direction: column; justify-content: center; align-items: center; margin-bottom: 20rpx; margin-left: 20rpx;">
          <p style="font-size: 40rpx; color: #9ca3af; line-height: 1;">+</p>
          <span style="font-size: 24rpx; color: #9ca3af; margin-top: 8rpx;">添加视频</span>
      </view>
  </view>
</view>

<view class="modern-card" style="margin-bottom: 40rpx; padding: 30rpx;">
  <view class="title" style="display: flex; align-items: center; margin-bottom: 20rpx;margin: 0 0 20rpx;">
      <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/so.png" mode="widthFix" style="width: 32rpx; height: 32rpx; margin-right: 12rpx;" />
      <p style="font-size: 30rpx; font-weight: 500; color: var(--text-main);">语音描述 (选填)</p>
  </view>

  <view class="ly" style="margin: 0;">
    <view class="editWrapBox" style="padding: 0;width: 100%; margin: 0; box-shadow: none;">
      <!-- 未录音 -->
      <block wx:if="{{noRecordShow}}">
        <view class="ks hover-scale" bindtap="authorize" style="background: #e0e7ff; color: #1e40af; border-radius: 40rpx; padding: 20rpx; text-align: center; font-size: 28rpx; display: flex; justify-content: center; align-items: center;">
          <p>点击开始录音</p>
        </view>
      </block>
      
      <!-- 录制语音中 -->
      <block wx:if="{{recordLuzhiShow}}">
        <view class="ks hover-scale" bindtap="stopRecordAudio" style="background: #fee2e2; color: #dc2626; border-radius: 40rpx; padding: 20rpx; text-align: center; font-size: 28rpx; display: flex; justify-content: center; align-items: center;">
          <p>录音中（{{countNume}}s） 点击停止</p>
        </view>
      </block>
      
      <!-- 播放语音中 -->
      <view wx:if="{{playAudioShow}}">
        <view class="bft" style="background: #d1fae5; color: #059669; border-radius: 40rpx; padding: 20rpx; text-align: center; font-size: 28rpx; display: flex; justify-content: center; align-items: center;">
          <p>播放中...</p>
        </view>
      </view>

      <!-- 录音完成 -->
      <block wx:if="{{finishRecordShow}}">
        <view class="bft" style="background: #f3f4f6; border-radius: 40rpx; padding: 20rpx; display: flex; justify-content: center; align-items: center; gap: 20rpx;">
          <view bindtap="playRecordAudio" data-type="1" style="display: flex; align-items: center; color: var(--primary-color); font-size: 28rpx;">
            <p>点击播放录音</p>
          </view>
          <image class="bftd" src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/d.png" mode="aspectFill" bindtap="recycleRecordAudio" style="width: 40rpx; height: 40rpx; padding: 10rpx;"></image>
        </view>
      </block>
    </view>
  </view>
</view>

<view style="position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 30rpx; background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05); z-index: 100;">
  <view class="modern-btn hover-scale" bindtap="save">立即提交上报</view>
</view>

</view>
<danger-btn />
