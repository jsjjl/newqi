<view class="page" style="padding: 20rpx;">
    <view class="search modern-card" style="margin: 0 0 20rpx 0; padding: 20rpx; display: flex; align-items: center; border-radius: var(--border-radius-xl);">
        <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/2/search.png" mode="widthFix" style="width: 32rpx; height: 32rpx; margin-right: 16rpx; opacity: 0.5;" />
        <input model:value="{{sn}}" bindinput="bindKeyInput" placeholder="搜索维修单号" type="text" style="flex: 1; font-size: 28rpx;" />
    </view>

    <view class="modern-card hover-scale" bindtap="go" data-detail="{{item}}" wx:for="{{ list }}" wx:key="index" style="margin-bottom: 24rpx; padding: 30rpx; border-radius: var(--border-radius-lg);">
        <view style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20rpx; border-bottom: 1rpx solid var(--border-color); padding-bottom: 20rpx;">
            <view style="font-size: 32rpx; font-weight: bold; color: var(--text-main); flex: 1; padding-right: 20rpx;">
                {{item.deviceName?item.deviceName:''}} {{item.sn?item.sn:''}}
            </view>
            <span class="{{'g'+item.status}}">{{item.status==0?'处理中':'已完成'}}</span>
        </view>
        <view style="display: flex; flex-direction: column; gap: 12rpx;">
            <view style="font-size: 28rpx; color: var(--text-main);" wx:if="{{item.faultDescription}}">
                故障现象：{{item.faultDescription}}
            </view>
            <view style="display: flex; justify-content: space-between; align-items: center; font-size: 26rpx; color: var(--text-muted);">
                <view>
                    <span wx:if="{{item.repairName}}" style="margin-right: 20rpx;">{{item.repairName}}</span>
                    <span wx:if="{{item.contact}}">{{item.contact}}</span>
                </view>
                <view style="display: flex; align-items: center;" wx:if="{{item.repairDate}}">
                    <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/new/time.svg" style="width: 24rpx; height: 24rpx; margin-right: 8rpx; opacity: 0.6;" mode="aspectFill"></image>
                    {{item.repairDate}}
                </view>
            </view>
        </view>
    </view>
    
    <view class="no" wx:if="{{noData}}" style="padding: 100rpx 0; text-align: center;">
        <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/no.png" mode="widthFix" style="width: 200rpx;" />
        <p style="color: var(--text-muted); margin-top: 20rpx; display: block; font-size: 28rpx;">暂无数据</p>
    </view>
</view>
<danger-btn />
