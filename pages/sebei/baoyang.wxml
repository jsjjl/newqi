<view class="top">
  <text>联系方式</text>
</view>
<view class="xlk">
  <input class="xlki" type="text" placeholder="请输入" bindinput="onContactInput" value="{{contact}}" />
</view>

</view>
<view class="editWrapBox">
  <view class="title">
    <image src="../../images/bz.svg" />
    <p>备注</p>
  </view>
<!-- <view class="top">
  <text>备注</text>
</view> -->
<view class="xlk" style="width: 100%; height: 200rpx; line-height:30rpx;">
  <textarea class="xlki" placeholder="请输入" bindinput="onRemarkInput" value="{{remark}}" style="width: 97%; height: 200rpx;line-height:30rpx;" />
  <!-- <input class="xlki" type="text" placeholder="请输入" bindinput="onRemarkInput" value="{{remark}}" /> -->
</view>
</view>

<view class="bt" bindtap="onSubmit">提交</view>
