  <picker mode="selector" range="{{userList}}" range-key="nickName" value="{{userIndex}}" bindchange="onUserChange">
    <view class="{{userIndex !== null ?'picker pickera':'picker'}}">{{userIndex !== null ? userList[userIndex].nickName : '请选择保养人'}}</view>
