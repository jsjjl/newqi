<div class="p-4" style="background: var(--bg-color); min-height: 100vh; padding-bottom: 120rpx;">
  <div class="modern-card" style="margin-bottom: 30rpx; padding: 40rpx 30rpx;">
    <div class="flex justify-between items-start mb-3" wx:if="{{detail.deviceName}}">
      <div style="width: 70%; float: left; margin:0 0 0rpx">
        <h2 class="text-lg font-medium" style="width: 100%; float: left; font-size: 36rpx; font-weight: bold; color: var(--text-main); margin-bottom: 12rpx;">
          {{detail.deviceName?detail.deviceName:'-'}}
        </h2>
        <p class="text-sm text-gray-500 mt-1" style="width: 100%; float: left; font-size: 26rpx; color: var(--text-muted); background: #f3f4f6; padding: 4rpx 16rpx; border-radius: 8rpx; display: inline-block;">
          设备编号: {{detail.deviceCode?detail.deviceCode:'-'}}
        </p>
      </div>
      <span class="px-2 py-1 rounded-full text-xs" style="margin-top: 6rpx;">
        <view wx:if="{{gq}}" class="picker pickera {{'g'+detail.overdueState}}" style="font-weight: bold; padding: 8rpx 20rpx; border-radius: 30rpx;">
          {{detail.overdueState==0?'正常':detail.overdueState==1?'即将到期':detail.overdueState==2?'已到期':''}}
        </view>
        <view wx:if="{{!gq}}" class="picker pickera {{'g'+detail.status}}" style="font-weight: bold; padding: 8rpx 20rpx; border-radius: 30rpx;">
        {{ 
  detail.status == 0 ? '正常' : 
  detail.status == 1 ? '维修' : 
  detail.status == 2 ? '保养' : 
  detail.status == 4 ? '维修&保养' : 
  '报废' 
}}
        </view>
      </span>
    </div>
    
    <div style="height: 1rpx; background: var(--border-color); margin: 30rpx 0;"></div>

    <div class="grid grid-cols-2 gap-3 text-sm ds">
     
      <div class="flex items-center" style="margin-bottom: 20rpx;">
        <image src="../../images/xx/1.svg" class="icon" style="width: 40rpx; height: 40rpx; margin-right: 16rpx;" />
        <div>
          <div class="text-gray-500 text-xs" style="color: var(--text-sub); margin-bottom: 4rpx;">制造日期</div>
          <div style="color: var(--text-main); font-weight: 500;">{{detail.manufactDate?detail.manufactDate:'-'}}</div>
        </div>
      </div>
      <div class="flex items-center" style="margin-bottom: 20rpx;">
        <image src="../../images/xx/3.svg" class="icon" style="width: 40rpx; height: 40rpx; margin-right: 16rpx;" />
        <div>
          <div class="text-gray-500 text-xs" style="color: var(--text-sub); margin-bottom: 4rpx;">使用效期</div>
          <div style="color: var(--text-main); font-weight: 500;">{{detail.validityDate?detail.validityDate:'-'}}</div>
        </div>
      </div>

       <div class="flex items-center" style="margin-bottom: 20rpx;">
        <image src="../../images/xx/1.svg" class="icon" style="width: 40rpx; height: 40rpx; margin-right: 16rpx;" />
        <div>
          <div class="text-gray-500 text-xs" style="color: var(--text-sub); margin-bottom: 4rpx;">使用证号</div>
          <div style="color: var(--text-main); font-weight: 500;">{{detail.useCertificate?detail.useCertificate:'-'}}</div>
        </div>
      </div>
      
      <!-- New Date Fields -->
      <div class="flex items-center hover-scale" bindtap="updateInspectionDate" style="margin-bottom: 20rpx; background: var(--primary-light); padding: 12rpx 16rpx; border-radius: 12rpx; border: 2rpx dashed var(--primary-color);">
        <image src="../../images/xx/3.svg" class="icon" style="width: 40rpx; height: 40rpx; margin-right: 16rpx;" />
        <div>
          <div class="text-gray-500 text-xs" style="color: var(--primary-color); font-weight: bold; margin-bottom: 4rpx;">巡检测试日期</div>
          <div style="color: var(--primary-dark); font-weight: 500; font-size: 24rpx;">{{detail.inspectionDate?detail.inspectionDate:'点击拍照更新'}}</div>
        </div>
      </div>
      
      <div class="flex items-center hover-scale" bindtap="updateMaintenanceDate" style="margin-bottom: 20rpx; background: var(--primary-light); padding: 12rpx 16rpx; border-radius: 12rpx; border: 2rpx dashed var(--primary-color);">
        <image src="../../images/xx/3.svg" class="icon" style="width: 40rpx; height: 40rpx; margin-right: 16rpx;" />
        <div>
          <div class="text-gray-500 text-xs" style="color: var(--primary-color); font-weight: bold; margin-bottom: 4rpx;">维修日期</div>
          <div style="color: var(--primary-dark); font-weight: 500; font-size: 24rpx;">{{detail.maintenanceDate?detail.maintenanceDate:'点击拍照更新'}}</div>
        </div>
      </div>

      <div class="flex items-center hover-scale" bindtap="updateReplacementDate" style="margin-bottom: 20rpx; background: var(--primary-light); padding: 12rpx 16rpx; border-radius: 12rpx; border: 2rpx dashed var(--primary-color);">
        <image src="../../images/xx/3.svg" class="icon" style="width: 40rpx; height: 40rpx; margin-right: 16rpx;" />
        <div>
          <div class="text-gray-500 text-xs" style="color: var(--primary-color); font-weight: bold; margin-bottom: 4rpx;">更换日期</div>
          <div style="color: var(--primary-dark); font-weight: 500; font-size: 24rpx;">{{detail.replacementDate?detail.replacementDate:'点击拍照更新'}}</div>
        </div>
      </div>
      
      <div class="flex items-center" style="margin-bottom: 20rpx;">
        <image src="../../images/xx/3.svg" class="icon" style="width: 40rpx; height: 40rpx; margin-right: 16rpx;" />
        <div>
          <div class="text-gray-500 text-xs" style="color: var(--text-sub); margin-bottom: 4rpx;">启用日期</div>
          <div style="color: var(--text-main); font-weight: 500;">{{detail.activationDate?detail.activationDate:'-'}}</div>
        </div>
      </div>

      <div class="flex items-center" wx:for="{{partKeys}}" wx:key="index" style="margin-bottom: 20rpx;">
        <image src="../../images/xx/3.svg" class="icon" style="width: 40rpx; height: 40rpx; margin-right: 16rpx;" />
        <div>
          <div class="text-gray-500 text-xs" style="color: var(--text-sub); margin-bottom: 4rpx;">{{item}}下次检验</div>
          <div style="color: var(--text-main); font-weight: 500;">{{detail.parts[item]}}</div>
        </div>
      </div>
    </div>
  </div>

  <div class="tabs" style="display: flex; background: #fff; border-radius: 20rpx; padding: 10rpx; margin-bottom: 30rpx; box-shadow: var(--shadow-sm);">
    <div class="{{tabs==1?'tab active':'tab'}}" bindtap="_tabs" data-id="1" style="flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; font-weight: 500; border-radius: 12rpx; transition: all 0.3s; color: {{tabs==1 ? '#fff' : 'var(--text-sub)'}}; background: {{tabs==1 ? 'var(--primary-color)' : 'transparent'}};">设备信息</div>
    <div class="{{tabs==2?'tab active':'tab'}}" bindtap="_tabs" data-id="2" style="flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; font-weight: 500; border-radius: 12rpx; transition: all 0.3s; color: {{tabs==2 ? '#fff' : 'var(--text-sub)'}}; background: {{tabs==2 ? 'var(--primary-color)' : 'transparent'}};">保养记录</div>
    <div class="{{tabs==3?'tab active':'tab'}}" bindtap="_tabs" data-id="3" style="flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; font-weight: 500; border-radius: 12rpx; transition: all 0.3s; color: {{tabs==3 ? '#fff' : 'var(--text-sub)'}}; background: {{tabs==3 ? 'var(--primary-color)' : 'transparent'}};">维修记录</div>
  </div>

  <div class="modern-card" wx:if="{{tabs==1}}">
    <h3 class="font-medium mb-3" style="font-size: 32rpx; font-weight: bold; margin-bottom: 30rpx; display: flex; align-items: center;"><view style="width: 8rpx; height: 32rpx; background: var(--primary-color); border-radius: 4rpx; margin-right: 16rpx;"></view>基本参数</h3>
    <div class="grid grid-cols-2 gap-2 text-sm">
       <div class="mb-4">
        <div class="text-gray-500" style="color: var(--text-sub); margin-bottom: 8rpx;">责任人</div>
        <div style="color: var(--text-main); font-weight: 500;">{{detail.responsibleName?detail.responsibleName:'-'}}</div>
      </div>
     
      <div class="mb-4">
        <div class="text-gray-500" style="color: var(--text-sub); margin-bottom: 8rpx;">院区</div>
        <div style="color: var(--text-main); font-weight: 500;">{{detail.areaName?detail.areaName:'-'}}</div>
      </div>
      <div class="mb-4">
        <div class="text-gray-500" style="color: var(--text-sub); margin-bottom: 8rpx;">所属建筑</div>
        <div style="color: var(--text-main); font-weight: 500;">{{detail.building?detail.building:'-'}}</div>
      </div>
      <div class="mb-4">
        <div class="text-gray-500" style="color: var(--text-sub); margin-bottom: 8rpx;">所属楼层</div>
        <div style="color: var(--text-main); font-weight: 500;">{{detail.floor?detail.floor:'-'}}</div>
      </div>
      <div class="mb-4">
        <div class="text-gray-500" style="color: var(--text-sub); margin-bottom: 8rpx;">房间号</div>
        <div style="color: var(--text-main); font-weight: 500;">{{detail.room?detail.room:'-'}}</div>
      </div>
      <div class="mb-4">
        <div class="text-gray-500" style="color: var(--text-sub); margin-bottom: 8rpx;">位置</div>
        <div style="color: var(--text-main); font-weight: 500;">{{detail.position?detail.position:'-'}}</div>
      </div> <div class="mb-4">
        <div class="text-gray-500" style="color: var(--text-sub); margin-bottom: 8rpx;">生产厂家</div>
        <div style="color: var(--text-main); font-weight: 500;">{{detail.manufacturer?detail.manufacturer:'-'}}</div>
      </div>
     
      <div class="mb-4" style="grid-column: span 2;">
        <div class="text-gray-500" style="color: var(--text-sub); margin-bottom: 8rpx;">备注</div>
        <div style="color: var(--text-main); background: #f9fafb; padding: 20rpx; border-radius: 8rpx; line-height: 1.5;">{{detail.remarks?detail.remarks:'-'}}</div>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm mb-4" wx:if="{{tabs==2}}" style="background: transparent;">
    <view class="modern-card hover-scale" bindtap="xgo" data-detail="{{item}}" wx:for="{{ list }}" wx:key="index" style="padding: 30rpx; margin-bottom: 24rpx;">
      <view class="xy_postbox_t" style="border-bottom: 1rpx solid var(--border-color); padding-bottom: 20rpx; margin-bottom: 20rpx; display: flex; justify-content: space-between; align-items: center;">
        <p style="width:70%; font-size: 32rpx; font-weight: bold; color: var(--text-main);">
          <i>
            {{item.type==1?'设备':'零部件'}} {{item.sn?item.sn:''}}
          </i>
        </p>
        <span class="{{'gx'+item.status}}" style="padding: 6rpx 16rpx; border-radius: 8rpx; font-size: 24rpx; font-weight: bold;">{{item.status==0?'处理中':'已完成'}}</span>
      </view>
      <view class="xy_postbox_f" style="display: flex; justify-content: space-between; align-items: center;">
        <p style="color: var(--text-sub); font-size: 28rpx;">
          <span wx:if="{{item.operatorName}}" style="margin-right: 20rpx;">{{item.operatorName?item.operatorName:''}}</span>
          <span wx:if="{{item.contact}}">{{item.contact?item.contact:''}}</span>
        </p>
        <i class="a" style="display: flex; align-items: center; color: var(--text-muted); font-size: 26rpx;" wx:if="{{item.maintainDate}}">
          <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/new/time.svg" class="ic_time" mode="aspectFill" style="width: 28rpx; height: 28rpx; margin-right: 8rpx;"></image>
          {{item.maintainDate?item.maintainDate:''}}
        </i>
      </view>
    </view>
    <view class="no" wx:if="{{noData}}" style="text-align: center; padding: 60rpx 0;">
      <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/no.png" class="no_img" mode="widthFix" style="width: 200rpx;" />
      <p style="color: var(--text-muted); margin-top: 20rpx; display: block;">暂无数据</p>
    </view>
  </div>

  <div class="bg-white rounded-lg shadow-sm mb-4" wx:if="{{tabs==3}}" style="background: transparent;">
    <view class="modern-card hover-scale" bindtap="ngo" data-detail="{{item}}" wx:for="{{ list }}" wx:key="index" style="padding: 30rpx; margin-bottom: 24rpx;">
      <view class="xy_postbox_t" style="border-bottom: 1rpx solid var(--border-color); padding-bottom: 20rpx; margin-bottom: 20rpx; display: flex; justify-content: space-between; align-items: center;">
        <p style="width:70%; font-size: 32rpx; font-weight: bold; color: var(--text-main);">
          <i>
            {{item.sn?item.sn:''}}
          </i>
        </p>
        <span class="{{'gx'+item.status}}" style="padding: 6rpx 16rpx; border-radius: 8rpx; font-size: 24rpx; font-weight: bold;">{{item.status==0?'处理中':'已完成'}}</span>
      </view>
      <view class="xy_postbox_f" style="display: flex; justify-content: space-between; align-items: center;">
        <p style="color: var(--text-sub); font-size: 28rpx; width: 60%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
          <span wx:if="{{item.faultDescription}}">
            {{item.faultDescription?item.faultDescription:''}}
          </span>
          <span wx:if="{{item.repairName}}" style="margin-left: 10rpx; color: var(--primary-color);">[{{item.repairName}}]</span>
        </p>
        <i class="a" style="display: flex; align-items: center; color: var(--text-muted); font-size: 26rpx;" wx:if="{{item.repairDate}}">
          <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/new/time.svg" class="ic_time" mode="aspectFill" style="width: 28rpx; height: 28rpx; margin-right: 8rpx;"></image>
          {{item.repairDate?item.repairDate:''}}
        </i>
      </view>
    </view>
    <view class="no" wx:if="{{noData}}" style="text-align: center; padding: 60rpx 0;">
      <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/no.png" class="no_img" mode="widthFix" style="width: 200rpx;" />
      <p style="color: var(--text-muted); margin-top: 20rpx; display: block;">暂无数据</p>
    </view>
  </div>

  <div class="modern-card" style="margin-top: 40rpx; padding: 30rpx;">
    <h3 class="font-medium mb-3 flex-between" style="font-size: 32rpx; font-weight: bold; margin-bottom: 30rpx; display: flex; align-items: center; justify-content: space-between;">
      <view style="display: flex; align-items: center;">
        <view style="width: 8rpx; height: 32rpx; background: var(--primary-color); border-radius: 4rpx; margin-right: 16rpx;"></view>近期检查记录
      </view>
      <div class="more" bindtap="toMore" style="font-size: 26rpx; color: var(--text-muted); font-weight: normal; display: flex; align-items: center;">查看全部 <text style="font-family: monospace; margin-left: 4rpx;">></text></div>
    </h3>
    
    <div class="hover-scale" wx:if="{{detail.lastTask}}" bindtap="toform" data-item="{{detail.lastTask}}" style="background: #f9fafb; padding: 24rpx; border-radius: 12rpx; border: 1rpx solid #e5e7eb;">
      <div class="flex justify-between items-start mb-2" style="border-bottom: 1rpx dashed #d1d5db; padding-bottom: 16rpx; margin-bottom: 16rpx;">
        <div>
          <div class="font-medium" style="font-size: 30rpx; color: var(--text-main); font-weight: bold; margin-bottom: 8rpx;">{{detail.lastTask.cycle}}</div>
          <div class="text-xs text-gray-500" style="color: var(--text-muted); font-size: 24rpx;">
            {{detail.lastTask.submitTime}}
          </div>
        </div>
        <span class="px-2 py-1 rounded-full text-xs">
          <span class="picker pickera gc{{detail.lastTask.state}}" style="padding: 6rpx 16rpx; border-radius: 8rpx; font-weight: bold;">
            {{detail.lastTask.state==1?'正常':'异常'}}
          </span>
        </span>
      </div>
      <div class="text-sm text-gray-600 dwz" style="color: var(--text-sub); font-size: 28rpx;">
        <p>巡检人: <span style="color: var(--text-main); font-weight: 500;">{{detail.lastTask.submitterName}}</span></p>
      </div>
    </div>
    <view class="no" wx:if="{{!detail.lastTask}}" style="text-align: center; padding: 40rpx 0;">
      <p style="color: var(--text-muted);">暂无记录</p>
    </view>
  </div>

  <div class="dban" wx:if="{{gly}}" style="position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 30rpx; background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05); z-index: 100; display: flex; gap: 20rpx;">
    <div bindtap="gowx" class="modern-btn hover-scale flex-1" style="flex: 1; background: #fff; color: var(--primary-color); border: 2rpx solid var(--primary-color); height: 88rpx; line-height: 84rpx;">添加维修</div>
    <div bindtap="goby" class="modern-btn hover-scale flex-1" style="flex: 1; height: 88rpx; line-height: 88rpx;">添加保养</div>
  </div>
</div>
<danger-btn />
