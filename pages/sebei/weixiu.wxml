<view class="top">
  <text>维修日期</text>
</view>
<view class="xlk">
  <picker mode="date" value="{{repairDate}}" bindchange="onDateChange">
    <view class="{{repairDate ?'picker pickera':'picker'}}">{{repairDate || '请选择日期'}}</view>
  </picker>
</view>
<view class="top">
  <text>联系方式</text>
</view>
<view class="xlk">
  <input class="xlki" type="text" placeholder="请输入" bindinput="onContactInput" value="{{contact}}" />
</view>
<view class="top">
