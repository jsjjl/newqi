<view class="editWrapBox">
  <view class="title">
    <image src="../../images/sb.svg" />
    <p>设备信息</p>
  </view>
  <view class="top">
    <text>设备名称</text>
  </view>
  <view class="xlk">
    <view wx:if="{{smsbid}}" class="picker pickera">{{smsbidName}}</view>
    <picker wx:else mode="selector" range="{{deviceList}}" range-key="deviceName" value="{{deviceIndex}}" bindchange="onDeviceChange">
      <view class="{{deviceIndex !== null ?'picker pickera':'picker'}}">
        {{deviceIndex !== null ? deviceList[deviceIndex].deviceName : '请选择设备'}}
      </view>
    </picker>
  </view>
  <view class="top">
    <text>设备编号</text>
  </view>
  <view class="xlk">
    <view wx:if="{{smsbid}}" class="picker pickera">{{smsbbh}}</view>
    <view wx:else class="{{deviceIndex !== null ?'picker pickera':'picker'}}">
      {{smsbbh?smsbbh:deviceIndex !== null ? deviceList[deviceIndex].deviceCode : ''}}
    </view>
  </view>
</view>

<view class="editWrapBox">
  <view class="title">
