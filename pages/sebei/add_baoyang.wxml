<view class="editWrapBox">
  <view class="title">
    <image src="../../images/pz.svg" />
    <p>视频</p>
  </view>
<!-- <view class="title">
  <image class="" src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/img.png" mode="widthFix" />
  <p>视频</p>
</view> -->
<view class="tp">
  <block wx:if="{{video}}">
    <view class="tpt" style="width:200rpx;height:150rpx; margin:0 10rpx 0 0">
      <video src="{{video}}" controls style="width:200rpx;height:150rpx; margin:0 0rpx 0 0" />
      <image class="del" src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/d.png" bindtap="deleteVideo" data-id="{{item}}" mode="aspectFill"></image>
    </view>
  </block>
  <view class="tpadd" bindtap="chooseVideo">
    <p>+</p>
    <span>添加视频</span>
  </view>
</view>
</view>

