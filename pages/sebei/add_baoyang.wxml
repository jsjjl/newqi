<view class="editWrapBox">
  <view class="title">
    <image src="../../images/pz.svg" />
    <p>图片</p>
  </view>

<!-- <view class="title">
  <image class="" src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/img.png" mode="widthFix" />
  <p>图片</p>
</view> -->
<view class="tp">
  <block wx:for='{{img_arr}}' wx:key='index' wx:for-item='item'>
    <view class="tpt">
      <image class="tptimg" src="{{item}}" mode="aspectFill" src='{{item}}' data-index="{{index}}" bindtap="previewImg" bindlongpress="deleteImg" name="headimage"></image>
      <image class="del" src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/d.png" bindtap="deleteImg" data-id="{{item}}" mode="aspectFill"></image>
    </view>
  </block>
  <view class="tpadd" bindtap="chooseImage">
    <p>+</p>
    <span>添加照片</span>
  </view>
</view>
</view>
