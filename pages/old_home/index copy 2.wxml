    <view class="boxs boxs3" wx:for="{{hpl}}" wx:key="item">
        <view class="title">
            <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/01/5.png" mode="widthFix" />
            <span>{{item.name}}</span>
        </view>
        <view class="boxs_f boxs_f01d">
            <p>
                <span>
                    {{item.leftPressure?item.leftPressure:'-'}}
                    <i wx:if="{{item.leftPressure!='OK' && item.leftPressure && item.leftPressure !='--'&& item.leftPressure !='--1'}}">{{areaId=='1797512499696791554'?'bar':'MPa'}}</i>
                </span>
                <em>左侧压力</em>
            </p>
            <p>
                <span>
                    {{item.rightPressure?item.rightPressure:'-'}}
                    <i wx:if="{{item.rightPressure!='OK' && item.rightPressure && item.rightPressure !='--'&& item.rightPressure !='--1'}}">{{areaId=='1797512499696791554'?'bar':'MPa'}}</i>
                </span>
                <em>右侧压力</em>
            </p>
            <p>
                <span>{{item.ros?item.ros:'-'}}</span>
                <em>在用状态</em>
            </p>
            <p>
                <span>
                    {{item.totalPressure?item.totalPressure:'-'}}
                    <i wx:if="{{item.totalPressure!='OK' && item.totalPressure  && item.totalPressure && item.totalPressure !='--'&& item.totalPressure !='--1'}}">{{areaId=='1797512499696791554'?'bar':'MPa'}}</i>
                </span>
                <em>出口压力</em>
            </p>
        </view>
    </view>
    <view class="boxs boxs4">
        <view class="title">
            <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/01/1.png" mode="widthFix" />
            <span>气体浓度</span>
        </view>
        <view class="boxs_f">
            <p wx:for="{{qtnd}}" wx:key="item">
                <span>
                    {{item.val}}
                    <i>%VOL</i>
                    <!-- <b></b> -->
                </span>
                <em>{{item.name}}</em>
            </p>
         
        </view>
    </view>
    <view class="boxs boxs5">
        <view class="title">
            <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/01/3.png" mode="widthFix" />
            <span>空气机组</span>
        </view>
        <view class="tb">
            <view class="tb_t jc" wx:if="{{kqjz.length>0}}">
                <!-- <span>设备位置</span>
                <span>设备名称</span>
                <span>运行状态</span>
                <span>运行时间</span> -->
                <span>设备名称</span>
                <span>警告状态</span>
                <span>运行状态</span>
                <span>运行时长</span>
            </view>
            <view class="tb_f">
                <view class="nomsg" wx:if="{{kqjz.length==0}}">暂无数据</view>
                <p wx:for="{{kqjz}}" wx:key="item">
                    <!-- <span>{{item.position}}楼号</span>
                    <span>{{item.name}}</span>
                    <span wx:if="{{item.warningFlag == false}}">运行</span>
                    <span wx:else class="red">停止</span>
                    <span>{{item.totalRunTime}}</span> -->
                    <span>{{item.name}}</span>
                    <span wx:if="{{item.warningFlag == true}}" class="red">警告</span>
                    <span wx:else>正常</span>
                    <span wx:if="{{item.runFlag == true}}">运行</span>
                    <span wx:else class="red">停止</span>
                    <span>{{item.totalRunTime}}</span>
                </p>
            </view>
        </view>
    </view>
    <view class="boxs boxs6">
        <view class="title">
            <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/01/4.png" mode="widthFix" />
            <span>真空机组</span>
        </view>
        <view class="tb">
            <view class="tb_t jc" wx:if="{{fyjz.length>0}}">
                <span>设备名称</span>
                <span>警告状态</span>
                <span>运行状态</span>
                <span>运行时长</span>
            </view>
            <view class="tb_f">
                <view class="nomsg" wx:if="{{fyjz.length==0}}">暂无数据</view>
                <p wx:for="{{fyjz}}" wx:key="item">
                    <!-- <span>{{item.position}}楼号</span> -->
                    <span>{{item.name}}</span>
                    <span wx:if="{{item.warningFlag == true}}" class="red">警告</span>
                    <span wx:else>正常</span>
                    <span wx:if="{{item.runFlag == true}}">运行</span>
                    <span wx:else class="red">停止</span>
                    <span>{{item.totalRuntime}}</span>
                </p>
            </view>
        </view>
    </view>
    <view class="boxs boxs7">
        <view class="title">
            <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/01/8.png" mode="widthFix" />
            <span>设备在线统计</span>
