        <block>
            <view class="tb tb8">
                <view class="tb_t jc" wx:if="{{sbzxtj.length>0}}">
                    <!-- <span >楼宇</span> -->
                    <span>设备类型</span>
                    <span>总数量</span>
                    <span>在线离线</span>
                </view>
                <view class="tb_f">
                    <view class="nomsg" wx:if="{{sbzxtj.length==0}}">暂无数据</view>
                    <p wx:for="{{sbzxtj}}" wx:for-item="itemt" wx:key="index">
                        <!-- <span>{{itemt.buildingNo}}</span> -->
                        <span>{{itemt.typeName}}</span>
                        <span>{{itemt.totalCount}}</span>
                        <span>{{itemt.onlineCount}}/{{itemt.offlineCount}}</span>
                    </p>
                </view>
            </view>
            <view class="fgx"></view>
        </block>
    </view>
