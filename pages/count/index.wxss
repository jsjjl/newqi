.title {
  width: 100%;
  height: auto;
  display: block;
  float: left;
  margin: 0rpx 0 0rpx;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.title image {
  width: 45rpx;
  height: 45rpx;
  display: block;
  float: left;
  margin: 0 20rpx 0 0;
  background: #1677ff;
  padding: 10rpx;
  border-radius: 100rpx;
}

.title span {
  width: auto;
  height: auto;
  display: block;
  float: left;
  line-height: 65rpx;
  font-size: 27rpx;
  color: #2f2f2f;
}

.title p {
  width: auto;
  height: auto;
  display: block;
  float: right;
  text-align: right;
  line-height: 55rpx;
  font-size: 27rpx;
  color: #1a1a1a;
}

.title p em {
  font-size: 36rpx;
  color: #1a1a1a;
}

page {
  background: var(--bg-color, #f5f6f8);
  /* height: 100%; position: fixed; width: 100%; overflow: auto; */
}

.bj {
  display: none;
}

.boxs {
  width: 680rpx;
  height: auto;
  display: block;
  float: left;
  border-radius: var(--border-radius-xl);
  background: var(--surface-color);
  box-shadow: var(--shadow-sm);
  margin: 20rpx 35rpx;
  padding: 35rpx 5px 20rpx;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.boxs:active {
  transform: scale(0.99);
}

.boxs .title span {
  color: #1a1a1a;
  font-weight: bold;
}

.boxs_f {
  width: 100%;
  height: 100%;
  display: block;
  float: left;
  color: #1a1a1a;
}

.boxs_f p {
  width: 33.333%;
  height: auto;
  display: block;
  float: left;
  text-align: center;
  margin: 30rpx 0 30rpx;
  padding: 0 10rpx;
  border-right: 1px solid rgba(255, 255, 255, 0.5);
  box-sizing: border-box;
  position: relative;
}

.boxs_f p:nth-child(3n) {
  border: 0;
}

.boxs_f01d p {
  width: 50%;
}

.boxs_f p span {
  width: 100%;
  height: auto;
  display: block;
  float: left;
  text-align: center;
  font-size: 40rpx;
}

.boxs_f p em {
  width: 100%;
  height: auto;
  display: block;
  float: left;
  text-align: center;
  font-size: 25rpx;
  font-style: normal;
}

.boxs_f p span i {
  font-size: 30rpx;
}

.boxs_f p span b {
  width: 15rpx;
  height: 15rpx;
  display: block;
  background: #1677ff;
  border-radius: 100rpx;
  margin: 0 0 0 15rpx;
  margin: auto;
}


