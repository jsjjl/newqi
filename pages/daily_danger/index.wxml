<view class="page">
  <view class="form-group">
    <view class="title"><text class="required">*</text>问题描述</view>
    <textarea class="textarea" placeholder="请详细描述隐患问题..." bindinput="onDescriptionInput" value="{{description}}" maxlength="500"></textarea>
  </view>
  
  <view class="form-group">
    <view class="title"><text class="required">*</text>现场照片 <text class="sub-title">(最多5张)</text></view>
    <view class="image-list">
      <block wx:for="{{img_arr}}" wx:key="*this">
        <view class="image-item">
          <image src="{{item}}" mode="aspectFill" bindtap="previewImg" data-index="{{index}}" />
          <view class="delete-btn" bindtap="deleteImg" data-index="{{index}}">×</view>
        </view>
      </block>
      <view class="add-btn" bindtap="addImg" wx:if="{{img_arr.length < 5}}">
        <text class="add-icon">+</text>
        <text class="add-text">添加照片</text>
      </view>
    </view>
  </view>

  <view class="submit-btn" bindtap="submit">提交隐患</view>
</view>