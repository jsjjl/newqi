.page {
  min-height: 100vh;
  background-color: var(--bg-color, #f5f6f8);
  padding: 30rpx;
}

.form-group {
  background: var(--surface-color);
  border-radius: var(--border-radius-xl);
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: var(--shadow-sm);
}

.title {
  font-size: 34rpx;
  color: var(--text-main);
  font-weight: bold;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.required {
  color: #ef4444;
  margin-right: 8rpx;
}

.sub-title {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: normal;
  margin-left: 10rpx;
}

.textarea {
  width: 100%;
  height: 240rpx;
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.5;
  background: #f9fafb;
  padding: 24rpx;
  border-radius: var(--border-radius-md);
  box-sizing: border-box;
  border: 1px solid transparent;
  transition: all 0.2s ease;
}

.textarea:focus {
  border-color: var(--primary-color);
  background: #fff;
  box-shadow: 0 0 0 2px var(--primary-light);
}

.image-list {
  display: flex;
  flex-wrap: wrap;
}

.image-item {
  width: 150rpx;
  height: 150rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
  border-radius: var(--border-radius-md);
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: var(--border-radius-md);
}

.delete-btn {
  position: absolute;
  top: -15rpx;
  right: -15rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(239, 68, 68, 0.9);
  color: #fff;
  font-size: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(239,68,68,0.3);
}

.add-btn {
  width: 150rpx;
  height: 150rpx;
  background: #f9fafb;
  border: 2rpx dashed #d1d5db;
  border-radius: var(--border-radius-md);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-bottom: 20rpx;
  transition: all 0.2s;
}
.add-btn:active {
  background: #f3f4f6;
  border-color: var(--primary-color);
}

.add-icon {
  font-size: 48rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: var(--text-muted);
}

.submit-btn {
  margin-top: 60rpx;
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(21, 104, 234, 0.3);
  transition: all 0.2s;
}

.submit-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 10rpx rgba(21, 104, 234, 0.2);
}