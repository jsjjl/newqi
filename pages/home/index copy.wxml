    </view>
    <view class="title" bindtap="go" data-id="/pages/lab/frontier_task2/home">
        待办任务
        <span>查看全部</span>
    </view>
    <view class="bg-white">
        <view class="pb-3"  bindtap="gorw" data-id="{{item.id}}" data-name="{{item.name?item.name:''}}" wx:for="{{ list }}"  wx:for="{{ list }}" wx:key="index">
            <view class="items-center">
                <span class="mr-2"></span>
                <span class="text-sm">{{item.name}}</span>
            </view>
            <span class="text-xs">{{item.startTime}}</span>
        </view>
        <view class="no" wx:if="{{noData}}">
            <!-- <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/no.png" class="no_img" mode="widthFix"  style="margin-top: 20rpx; margin-left:210rpx"/> -->
            <p>暂无数据</p>
        </view>
    </view>

     <!-- 底部口号 -->
  <view class="footer">
    <text>医用气体管理系统 · 智慧守护您的安全</text>
  </view>
