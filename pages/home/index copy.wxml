            <view class="box_t" style="background: #d1fae5;">
                <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/new/s2_1.svg" mode="widthFix" class="box_img" />
            </view>
            <view class="box-title">气体借用</view>
