<view class="main">
    <view class="header">
        <view class="top_fr">
            <span>{{topmsg.top}}</span>
            <p>{{topmsg.bottom}}</p>
        </view>
        <view class="tx">
            <image wx:if="{{tx}}" src="{{tx}}" mode="widthFix" />
            <image wx:else src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/new/01_2.svg" mode="widthFix" />
        </view>
    </view>
    <view class="title">快速操作</view>
    <view class="boxs">
        <view class="box" bindtap="go" data-id="/pages/lab/frontier_form/home">
            <view class="box_t" style="background: #dbeafe;">
                <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/new/s3_1.svg" mode="widthFix" class="box_img" />
            </view>
            <view class="box-title">扫码巡检</view>
        </view>

          <view class="box" bindtap="go" data-id="/pages/sebei/home">
            <view class="box_t" style="background: #dbeafe;">
                <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/new/s1_1.svg" mode="widthFix" class="box_img" />
            </view>
            <view class="box-title">设备查询</view>
        </view>

        <view class="box" bindtap="go"  data-sm="1"  data-id="/pages/sebei/baoyang">
            <view class="box_t" style="background:rgb(250, 218, 236);">
               <image src="../../images/icon/byjl.svg" mode="widthFix" class="box_img" />
            </view>
            <view class="box-title">设备保养</view>
        </view>
          <view class="box" bindtap="go" data-sm="1" data-id="/pages/sebei/weixiu">
            <view class="box_t" style="background:#f7eed9;">
                <image src="../../images/icon/wxjl.svg"  mode="widthFix" class="box_img" />
            </view>
            <view class="box-title">设备维修</view>
        </view>
