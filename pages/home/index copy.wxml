            </view>
            <view class="box-title">每日任务</view>
        </view> -->
    </view>
    <view class="title">平台状态</view>
    <view class="grid">
        <view class="grid-border" bindtap="go" data-id="/pages/lab/frontier_task2/home">
            <view class="text-sm text-gray-500 mb-1">今日巡检</view>
            <view class="flex items-end justify-between">
                <view class="text-xl font-medium" style="color:#3b82f6">
                    {{opsWxTaskCount?opsWxTaskCount:0}}
                    </view>
                <!-- <view class="text-xs text-blue-500">62%</view> -->
            </view>
            <view class="w-full bg-gray-200 rounded-full h-1.5 mt-2">
                <view class="bg-blue-500 h-1.5 rounded-full" style="width:100%"></view>
            </view>
        </view>
         <view class="grid-border" bindtap="go" data-id="/pages/sebei/home2">
            <view class="text-sm text-gray-500 mb-1">设备状态</view>
            <view class="flex items-end justify-between">
                <view class="text-xl font-medium"  style="color:#10b981">{{deviceExpireCount.overdue?deviceExpireCount.overdue:0}}/{{deviceExpireCount.total?deviceExpireCount.total:0}}</view>
                <view class="text-xs text-green-500"></view>
            </view>
            <view class="w-full bg-gray-200 rounded-full h-1.5 mt-2">
                <view   class="bg-green-500 h-1.5 rounded-full" style="width:100%"></view>
            </view>
        </view>
