
.tx {
  width: 100rpx;
  height: 100rpx;
  display: block;
  float: right;
  margin: 0 0rpx 0 0;
  border-radius: 1000rpx;
  background: #fff;
  overflow: hidden;
}

.tx image {
  width: 100%;
  height: 100%;
  display: block;
  float: left;
}
.main{
  padding: 25rpx;
  width: 100%;
  float: left;
  box-sizing: border-box;
}
.header{
  width: 100%;
  height: auto;
  display: block;
  float: left;
  background-color: rgba(239, 246, 255, 1);
  border-radius: 20rpx;  box-sizing: border-box;
  padding: 30rpx;
}
.top_fr{
  width: 400rpx;
  height: auto;
  display: block;
  float: left;
}
.top_fr span{
  width: 100%;
  height: auto;
  display: block;
  float: left;
  font-size: 35rpx;
  color: #1e40af;
  margin: 10rpx 0 5rpx 0;
  font-weight: bold;
}
.top_fr p{
  width: 100%;
  height: auto;
  display: block;
  float: left;
  font-size: 28rpx;
  color: #2563eb;
  font-weight: normal;
}

.boxs {
  width: 100%;
  display: grid;

  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin: 10rpx 0 20rpx;
}

.box {
  display: flex;flex-direction: column;align-items: center;
}
.box_t{
  width: 110rpx;
  height: 110rpx;
  line-height: 110rpx;
  text-align: center;
  border-radius: 200rpx;
  align-items: center;justify-content: center;    margin-bottom: 10rpx;
  position: relative;
}
.box_img{
  width:60rpx;
  height: 60rpx;display: inline-block;
  vertical-align: middle; margin: auto;
}
.badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #ef4444;
  color: #fff;
  font-size: 30rpx;
  min-width: 45rpx;
  height: 45rpx;
  line-height: 45rpx;
  text-align: center;
  border-radius: 160rpx;
  padding: 0 0rpx;
  border: 2rpx solid #fff;
  box-sizing: border-box;
  font-weight: bold;
}
.box-title{
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;color: rgba(75, 85, 99, 1);
}
.title {
  width: 100%;
  display: block;
  /* float: left; */
  font-size: 30rpx;
  color: #333;
  margin: 20rpx 0;
}
.grid{
  width: 100%;
  display: block;
  float: left;
  margin: 0 0 20rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));display: grid;gap: 20rpx;
}
.grid-border{
  border:1px solid rgba(229, 231, 235, 1);
  border-radius: 20rpx;
  padding: 20rpx;  box-sizing: border-box;
}
.grid-border .text-sm{
  font-size:28rpx;
    line-height: 40rpx;
    margin-bottom: 10rpx;color: rgba(107, 114, 128, 1);
}
.grid-border .items-end{
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.text-xl{
  font-size: 40rpx;
  line-height: 60rpx;font-weight: 500;
}
.text-xs {
  font-size: .75rem;
  line-height: 1rem;
  color: rgba(16, 185, 129, 1);
}
.w-full{
  border-radius: 9999px;
  background-color: rgba(229, 231, 235,1);
  height: 12rpx;
  width: 100%;
}

.bg-green-500{  height: 12rpx;
  border-radius: 9999px;
  background-color: rgba(16, 185, 129, 1);
}

.bg-red-500{  height: 12rpx;
  border-radius: 9999px;
  background-color: rgba(239,68,68,1);
}


.bg-blue-500{  height: 12rpx;
  border-radius: 9999px;
  background-color: rgba(59,130,246,1);
}

.title span{
  color: rgba(59, 130, 246, 1);
  font-size: 28rpx;
  line-height: 50rpx;
  display: block;
  float: right;
}

.bg-white{
  display: block;
  float: left;
  width: 100%;
  background: #fff;
  padding: 20rpx;
  box-sizing: border-box;
  box-shadow: var(0 0 #0000, 0 0 #0000), var(0 0 #0000, 0 0 #0000), var(0 1px 2px 0 rgba(0, 0, 0, 0.05));
  
}
.pb-3{
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(229, 231, 235, 1);
  padding-bottom:20rpx;
  margin-bottom: 20rpx;
}
.pb-3 .items-center{
  display: flex;
  align-items: center;
}
.mr-2{
  border-radius: 9999px;
  width: 20rpx;
  height: 20rpx;
  background-color: rgba(245, 158, 11, 1);
  border-radius: 20rpx;
  margin-right: 20rpx;
}
.mr-2 .text-sm{
  font-size: 30rpx;
  line-height: 30rpx;
}

.text-xs{
  font-size: 26rpx;
  line-height: 30rpx;
  color: rgba(107, 114, 128,1);
}

.bg-gray-200{
  /* display: none; */
}



.today {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
}
.footer {
  width: 100%;
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
  margin: 40rpx 0 10rpx 0;
  letter-spacing: 2rpx;
}
.no_img {
  width: 180rpx;
  height: 180rpx;
  display: block;
  margin: 0 auto 10rpx auto;
}
.no p {
  text-align: center;
  color: #b0b0b0;
  font-size: 28rpx;
}
.boxs {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20rpx;
}
.box {
  transition: box-shadow 0.2s;
}
.box:active {
  box-shadow: 0 4rpx 16rpx rgba(59,130,246,0.08);
  transform: scale(0.97);
}

.banner-swiper {
  width: 100%;
  height: 300rpx;
  margin-top: 30rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
  transform: translateY(0);
  float: left;
  margin-bottom: 25rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

.safety-news-container {
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 10rpx 20rpx;
}

.news-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1px solid rgba(229, 231, 235, 1);
}

.news-item:last-child {
  border-bottom: none;
}

.news-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 120rpx;
  padding-right: 20rpx;
}

.news-title {
  font-size: 30rpx;
  color: #333;
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.news-date {
  font-size: 24rpx;
  color: #9ca3af;
}

.news-thumb {
  width: 160rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
}