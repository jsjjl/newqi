  <picker mode="selector" range="{{userList}}" range-key="nickName" value="{{selectedUserId}}" bindchange="onUserChange">
    <view class="{{selectedUserId !== '' ? 'picker pickera' : 'picker'}}">
      {{selectedUserId !== '' ? userList[selectedUserId].nickName : '请选择'}}
    </view>
  </picker>
</view> -->

<view class="top">
  <text>借用时间</text>
</view>
<view class="xlk">
  <picker mode="date" value="{{borrowTime}}" bindchange="onBorrowTimeChange">
    <view class="{{borrowTime ? 'picker pickera' : 'picker'}}" style="width:200rpx;">
      {{borrowTime || '请选择日期'}}
    </view>
  </picker>
  <picker mode="time" value="{{borrowTime2}}" bindchange="onBorrowTimeChange2">
    <view class="{{borrowTime2 ? 'picker pickera' : 'picker'}}" style="width:400rpx;">
      {{borrowTime2 || '请选择时间'}}
    </view>
  </picker>
</view>


<view class="top">
  <text>用途说明</text>
</view>
<view class="xlk">

  <input class="xlki" type="text" placeholder="请输入" bindinput="onPurposeInput" value="{{purpose}}" />

</view>

</view>


<view class="editWrapBox">
  <view class="title">
    <image src="../../images/yqp.svg" />
    <p>气体信息</p>
  </view>

<view class="top">
  <text>气体类型</text>
</view>
<view class="xlk">
  <picker mode="selector" range="{{gasTypeList}}" range-key="dictLabel" value="{{selectedGasTypeId}}" bindchange="onGasTypeChange">
    <view class="{{selectedGasTypeId !== '' ? 'picker pickera' : 'picker'}}">
      {{selectedGasTypeId !== '' ? gasTypeList[selectedGasTypeId].dictLabel : '请选择'}}
    </view>
  </picker>
</view>
<view class="top">
  <text>气体规格</text>
</view>
<view class="xlk">
  <picker mode="selector" range="{{gasSpecList}}" range-key="bottleSpecLabel" value="{{selectedGasSpecId}}" bindchange="onGasSpecChange">
    <view class="{{selectedGasSpecId !== '' ? 'picker pickera' : 'picker'}}">
      {{selectedGasSpecId !== '' ? gasSpecList[selectedGasSpecId].bottleSpecLabel : '请选择'}}
    </view>
  </picker>
</view>
<view class="top">
  <text>借用数量</text>
</view>
<view class="xlk">
  <input class="xlki" type="number" placeholder="请输入" bindinput="onQuantityInput" value="{{quantity}}" />
</view>
</view>

