<view class="{{tc?'itc':''}}">
<view class="editWrapBox">
  <view class="title">
    <image src="../../images/sb.svg" />
    <p>借用信息</p>
  </view>

<!-- 
  <view class="title">
    <text>气体借用申请</text>
  </view> -->
<view class="top">
  <text>院区</text>
</view>
<view class="xlk">
  <picker mode="selector" range="{{areaList}}" range-key="name" value="{{selectedAreaId}}" bindchange="onAreaChange">
    <view class="{{selectedAreaId !== '' ? 'picker pickera' : 'picker'}}">
      {{selectedAreaId !== '' ? areaList[selectedAreaId].name : '请选择'}}
    </view>
  </picker>
</view>

<view class="top">
  <text>病区</text>
</view>
<view class="xlk">
  <picker mode="selector" range="{{wardList}}" range-key="name" value="{{selectedWardId}}" bindchange="onWardChange">
    <view class="{{selectedWardId !== '' ? 'picker pickera' : 'picker'}}">
      {{selectedWardId !== '' ? wardList[selectedWardId].name : '请选择'}}
    </view>
  </picker>
</view>

<view class="top">
  <text>借用人</text>
</view>
<view class="xlk" style="position:relative;">
  <input
    class="xlki"
    placeholder="请输入借用人姓名"
    bindinput="onUserInput"
    value="{{userInput}}"
    bindfocus="onUserFocus"
    bindblur="onUserBlur"
    confirm-type="done"
  />
  <!-- 下拉建议列表 -->
  <view wx:if="{{showUserSuggest && filteredUserList.length > 0}}" style="position:absolute;top:80rpx;left:0;right:0;z-index:99;background:#fff;border:1px solid #eee;border-radius:20rpx; max-height:400rpx; overflow:auto;box-sizing:border-box;">
    <view wx:for="{{filteredUserList}}" wx:key="userId" class="picker pickera" style="padding:0 30rpx;box-sizing:border-box;" bindtap="onUserSelect" data-index="{{index}}">
      {{item.nickName}}
    </view>
  </view>
</view>
