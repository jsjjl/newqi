<view class="editWrapBox">
  <view class="title">
    <image src="../../images/qz.svg" />
    <p>借用确认单</p>
  </view>
<!-- <view class="title">
  <p>签名图片</p>
</view> -->
<view class="tp" style="float: left;dispaly:block">

 <image wx:if="{{lstp}}" src="{{lstp}}" mode="aspectFill" data-index="0" data-pictures="{{lstp}}" bindtap="previewImg" style="width:220rpx;height:220rpx;float:none;margin:0 0 20rpx; dispaly:block" name="headimage"></image>
     

  <view class="qm" bindtap="showt">{{lstp?'重新签名':'点击签名'}}</view>
  
</view>
</view>
<view class="tcc" wx:if="{{tc}}">
<view class="container">
  <!-- Canvas 绘图区域 -->
   <view class="tcbt">请在以下空白处签字</view>
  <canvas 
    type="2d" 
    id="signatureCanvas" 
    style="width: 100%; height: 1100rpx; border: 1px solid #ccc; background: #fff;"
    bindtouchstart="touchStart"
    bindtouchmove="touchMove"
    bindtouchend="touchEnd"
  ></canvas>

  <!-- 操作按钮 -->
  <view class="button-group" >
    <view class="button-group-bt button-group-bt1" bindtap="clearCanvas">清除</view>
    <view class="button-group-bt button-group-bt2" bindtap="saveSignature">保存签名</view>
    <view  class="button-group-bt button-group-bt3" bindtap="closet">关闭</view>
  </view>
</view>
</view>

<view class="bt" bindtap="onSubmit">提交</view>
</view>