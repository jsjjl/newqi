.page { min-height: 100vh; background-color: var(--bg-color, #f5f6f8); padding: 30rpx; box-sizing: border-box; }
.loading-state { text-align: center; padding: 100rpx 0; color: var(--text-muted); font-size: 28rpx; }
.empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding-top: 200rpx; }
.empty-img { width: 280rpx; margin-bottom: 40rpx; }
.empty-text { font-size: 32rpx; color: var(--text-main); font-weight: bold; margin-bottom: 16rpx; }
.empty-subtext { font-size: 26rpx; color: var(--text-muted); text-align: center; }
.task-card { background: var(--surface-color); border-radius: var(--border-radius-lg); padding: 30rpx; margin-bottom: 30rpx; box-shadow: var(--shadow-sm); transition: transform 0.2s; }
.task-card:active { transform: scale(0.98); }
.task-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; border-bottom: 1rpx solid var(--border-color); padding-bottom: 20rpx; }
.task-title { font-size: 34rpx; font-weight: bold; color: var(--text-main); flex: 1; }
.task-status { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 8rpx; font-weight: bold; }
.status-pending { background: #fff1f0; color: #ef4444; }
.status-done { background: #f6ffed; color: #10b981; }
.task-body { margin-bottom: 30rpx; }
.info-row { display: flex; margin-bottom: 16rpx; font-size: 28rpx; line-height: 1.5; }
.label { color: var(--text-sub); width: 140rpx; flex-shrink: 0; }
.value { color: var(--text-main); flex: 1; }
.task-footer { display: flex; justify-content: flex-end; }
.btn-primary { margin: 0; padding: 0 40rpx; height: 64rpx; line-height: 64rpx; background: linear-gradient(135deg, var(--primary-color), var(--primary-dark)); color: #fff; font-size: 28rpx; border-radius: 32rpx; box-shadow: 0 4rpx 10rpx rgba(21,104,234,0.2); }
.btn-default { margin: 0; padding: 0 40rpx; height: 64rpx; line-height: 64rpx; background: #f5f6f8; color: var(--text-sub); font-size: 28rpx; border-radius: 32rpx; }