<view class="page" style="padding: 30rpx 24rpx;">
    <view class="modern-card boxs" style="padding: 0 30rpx;">
        <view class="box" style="display: flex; justify-content: space-between; align-items: center;">
            <view class="boxl" style="color: var(--text-main); font-weight: 500;">头像</view>
            <button class="avatar-wrapper" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar" style="margin: 20rpx 0; padding: 0; width: 100rpx; height: 100rpx; border-radius: 50%; background: none; overflow: hidden; box-shadow: var(--shadow-sm);">
                <image class="txs" wx:if="{{avatar}}" src="{{avatar}}" style="width: 100%; height: 100%;" mode="aspectFill"></image>
                <image wx:else src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/new/01_2.svg" class="txs" style="width: 100%; height: 100%;" mode="aspectFill" />
            </button>
        </view>
        <view class="box" style="display: flex; justify-content: space-between; align-items: center;">
            <view class="boxl" style="color: var(--text-main); font-weight: 500;">姓名</view>
            <input type="nickname" :model="{{nickName}}" value="{{nickName}}" class="nc" bindblur="bindKeyInput" placeholder="请输入姓名" placeholder-style="color: var(--text-muted);" style="text-align: right; font-size: 32rpx; color: var(--text-main); flex: 1;" />
        </view>
        <view class="box" style="display: flex; justify-content: space-between; align-items: center;">
            <view class="boxl" style="color: var(--text-main); font-weight: 500;">科室</view>
            <input type="text" value="{{deptName}}" class="nc" bindblur="bindKeydeptName" placeholder="请输入关联科室名称" placeholder-style="color: var(--text-muted);" style="text-align: right; font-size: 32rpx; color: var(--text-main); flex: 1;" />
        </view>
        <view class="box" style="display: flex; justify-content: space-between; align-items: center; border-bottom: none;">
            <view class="boxl" style="color: var(--text-main); font-weight: 500;">手机号码</view>
             <input type="number" value="{{phonenumber}}" class="nc" bindblur="bindKeyPhone" placeholder="请输入手机号码" placeholder-style="color: var(--text-muted);" style="text-align: right; font-size: 32rpx; color: var(--text-main); flex: 1;" />
        </view>
    </view>

    <view class="modern-btn hover-scale" bindtap="xgmm" style="margin-top: 60rpx;">修改密码</view>
    <view class="hover-scale" bindtap="exit" style="margin-top: 40rpx; text-align: center; height: 88rpx; line-height: 88rpx; color: #ef4444; font-size: 32rpx; font-weight: 500; background: var(--surface-color); border-radius: var(--border-radius-xl); box-shadow: var(--shadow-sm);">退出登录</view>
</view>
<danger-btn />
