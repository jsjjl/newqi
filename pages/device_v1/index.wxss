  .title{ width: 100%; height: auto; display: block; float: left; margin: 20rpx 0 10rpx; padding:0 30rpx; box-sizing: border-box;}
  .title image{ width: 55rpx; height: 55rpx; display: block; float: left; margin: 0 20rpx 0 0;}
  .title  span{ width: auto; height: auto; display: block; float: left; line-height: 55rpx; font-size: 27rpx; color: #2f2f2f;}


.top{ width: 100%; height: auto; display: block; float: left;}
.fb{ width:680rpx; height: auto; display: block; float: left; margin: 30rpx 35rpx;}
.ech{ width: 100%; height: auto; display: block; float: left;}
.tb{ width: 680rpx; height: auto;display: block; float: left; margin:  30rpx 35rpx 30rpx; }
.tb_t { width: 100%; height: auto; display: block; float: left; margin: 0 0 20rpx 0; }
.tb_t span{ font-size: 27rpx; color: #252525;display: block; float: left; text-align: center; padding: 0 5rpx; box-sizing: border-box; }
.tb_t span:nth-child(1),.tb_f span:nth-child(1){ width: 30%;}
.tb_t span:nth-child(2),.tb_f span:nth-child(2){ width: 20%; }
.tb_t span:nth-child(3),.tb_f span:nth-child(3){ width: 30%; }
.tb_t span:nth-child(4),.tb_f span:nth-child(4){ width: 20%; }


.tb_f { width: 100%; height: auto; display: block; float: left; }
.tb_f p{ width: 100%; height: auto; display: block; float: left; margin: 0 0 20rpx 0; }
.tb_f span{ font-size: 27rpx; color: #2f2f2f;display: block; float: left; text-align: center; padding: 0 5rpx; box-sizing: border-box; }
/* .tb_f span:nth-child(1){ width: 70%;} */
.tb_f span:nth-child(4){ color: #29a000;}


.boxs{ width:680rpx; height: auto; display: block; float: left;  border-radius: 30rpx;
    /* background-image: -moz-linear-gradient( -1deg, rgb(177,239,192) 0%, rgb(1,197,134) 100%);
    background-image: -webkit-linear-gradient( -1deg, rgb(177,239,192) 0%, rgb(1,197,134) 100%);
    background-image: -ms-linear-gradient( -1deg, rgb(177,239,192) 0%, rgb(1,197,134) 100%); */
    background: #1677ff;
    box-shadow: 0px 12rpx 18rpx 2rpx rgba(22, 119, 255, 0.25);
    margin: 30rpx 35rpx;
}
.boxs .title span{ color: #fff;}
.boxs_f{ width: 100%;  height: 100%; display: block; float: left; color: #fff; }
.boxs_f p{ width: 33.333%; height: auto; display: block; float: left; text-align: center; margin: 30rpx 0 50rpx; padding: 0 10rpx; border-right: 1px solid rgba(255, 255, 255, 0.5); box-sizing: border-box; }
.boxs_f p:nth-child(4n){border: 0;}
.boxs_f p span{ width: 100%; height: auto; display: block; float: left; text-align: center;  font-size: 50rpx; }
.boxs_f p em{ width: 100%; height: auto; display: block; float: left; text-align: center;  font-size: 25rpx; font-style: normal;}
.boxs_f p span i {font-size: 30rpx;}
