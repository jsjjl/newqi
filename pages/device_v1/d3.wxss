.ec-canvas1 {
  width: 90%;
  height: 500rpx;
  display: block;
  float: left;
  margin: 0rpx 5%;
  position: relative;
}







.ec-canvas2 {
  width: 90%;
  height: 600rpx;
  display: block;
  float: left;
  margin: 0rpx 5% 50rpx;
  position: relative;
}

.ant {
  width: 90%;
  height: auto;
  display: block;
  float: left;
  margin: 20rpx 5% 20rpx;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  border: 1px solid #1677ff;
  border-radius: 20rpx;
}

.antl {
  width: 60rpx;
  height: 60rpx;
  display: block;
  float: left;
  margin: 10rpx 0 0 0;
}

.ant span {
  width: auto;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0 0 0 20rpx;
  display: block;
  float: left;
}

.antr {
  width: 50rpx;
  height: 50rpx;
  display: block;
  float: right;
  margin: 15rpx 0rpx 0 0;
  opacity: .5;
}

.title {
  width: 100%;
  height: auto;
  display: block;
  float: left;
  margin: 20rpx 0 10rpx;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.title image {
  width: 55rpx;
  height: 55rpx;
  display: block;
  float: left;
  margin: 0 20rpx 0 0;
}

.title span {
  width: auto;
  height: auto;
  display: block;
  float: left;
  line-height: 55rpx;
  font-size: 27rpx;
  color: #2f2f2f;
}


.top {
  width: 100%;
  height: auto;
  display: block;
  float: left;
}

.fb {
  width: 680rpx;
  height: auto;
  display: block;
  float: left;
  margin: 30rpx 35rpx;
}

.ech {
  width: 100%;
  height: auto;
  display: block;
  float: left;
}

.tb {
  width: 680rpx;
  height: auto;
  display: block;
  float: left;
  margin: 10rpx 35rpx 30rpx;
  background: #fff;
  box-sizing: border-box;
  border-radius: 20rpx;
  padding:5rpx 15px 15rpx;
  box-shadow: 0px 12rpx 18rpx 2rpx rgba(0, 0, 0, 0.05);
}


.tb_t {
  width: 100%;
  height: auto;
  display: block;
  float: left;
  margin: 0 0 20rpx 0;
    padding-bottom: 20rpx;
  border-bottom: 5rpx solid #e9e9e9;
}

.tb_t span {
  font-size: 27rpx;
  color: #252525;
  display: block;
  float: left;
  text-align: center;
  padding: 0 5rpx;
  box-sizing: border-box;
  font-weight: bold;
    width:33.3%;
    
}
/* 
.tb_t span:nth-child(1),
.tb_f span:nth-child(1) {
  width:25%;
}

.tb_t span:nth-child(2),
.tb_f span:nth-child(2) {
  width: 25%;
