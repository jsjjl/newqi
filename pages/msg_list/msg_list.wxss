
page {
  background: var(--bg-color, #f4f6f9);
}
.tabs {
  display: flex;
  background-color: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  height: 100rpx;
  box-shadow: var(--shadow-sm);
}

.tab-item {
  flex: 1;
  text-align: center;
  line-height: 100rpx;
  font-size: 30rpx;
  color: var(--text-muted);
  position: relative;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: bold;
  font-size: 32rpx;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 8rpx;
  background: linear-gradient(90deg, var(--primary-color), var(--primary-light));
  border-radius: 4rpx;
  box-shadow: 0 4rpx 8rpx rgba(22,119,255,0.3);
}

.unread {
  background: #fff;
  border-left: 8rpx solid #ef4444;
}