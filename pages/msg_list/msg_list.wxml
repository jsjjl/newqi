

<view class="tabs">
  <block wx:for="{{tabs}}" wx:key="index">
    <view class="tab-item {{currentTab == index ? 'active' : ''}}" bindtap="switchTab" data-index="{{index}}">
      {{item}}
    </view>
  </block>
</view>

<view class="list-container" style="padding: 120rpx 30rpx 40rpx;">
  <block wx:for='{{listData}}' wx:key='index' wx:for-item='item'>
    <view class="modern-card hover-scale box {{item.isRead == 0 ? 'unread' : ''}}" bindtap="toxx" data-id="{{item.noticeId}}" data-istask="{{item.isTask}}" data-iswarning="{{item.isWarning}}" style="margin-bottom: 24rpx; padding: 30rpx; border-radius: var(--border-radius-lg); display: flex; flex-direction: column; position: relative;">
        <view class="msg-header" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16rpx;">
            <span style="font-size: 32rpx; font-weight: 500; color: var(--text-main); flex: 1; padding-right: 20rpx;">{{item.noticeTitle || item.title}}</span>
            <view wx:if="{{item.isRead == 0}}" style="width: 16rpx; height: 16rpx; background: #ef4444; border-radius: 50%; margin-top: 12rpx; flex-shrink: 0;"></view>
        </view>
        <view class="msg-footer" style="display: flex; justify-content: space-between; align-items: center;">
            <p style="font-size: 26rpx; color: var(--text-muted);">{{item.createTime || item.time}}</p>
            <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/more.png" mode="widthFix" style="width: 24rpx; opacity: 0.3;" />
        </view>
    </view>
  </block>

  <view class="no" wx:if="{{no}}" style="padding: 100rpx 0; text-align: center;">
        <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/no.png" class="no_img" mode="widthFix" style="width: 200rpx;" />
        <p style="color: var(--text-muted); margin-top: 20rpx; display: block; font-size: 28rpx;">暂无数据</p>
  </view>
</view>

<danger-btn />
