<view class="page" style="padding: 30rpx 24rpx; background: var(--bg-color, #f5f6f8); min-height: 100vh;">
  <view class="modern-card" style="padding: 20rpx; border-radius: var(--border-radius-xl); box-shadow: var(--shadow-sm); background: #fff;">
    <view style="font-size: 32rpx; font-weight: bold; color: var(--text-main); margin: 20rpx 10rpx 30rpx; display: flex; align-items: center;">
      <view style="width: 8rpx; height: 32rpx; background: var(--primary-color); border-radius: 4rpx; margin-right: 16rpx;"></view>
      请在此区域签名
    </view>
    
    <!-- Canvas 绘图区域 -->
    <canvas 
      type="2d" 
      id="signatureCanvas" 
      style="width: 100%; height: 400px; background: #f9fafb; border: 2rpx dashed var(--border-color); border-radius: var(--border-radius-md); box-sizing: border-box;"
      bindtouchstart="touchStart"
      bindtouchmove="touchMove"
      bindtouchend="touchEnd"
    ></canvas>

    <!-- 操作按钮 -->
    <view class="button-group" style="display: flex; justify-content: space-between; margin-top: 40rpx; padding: 0 10rpx 20rpx;">
      <button class="hover-scale" bindtap="clearCanvas" style="width: 45%; margin: 0; background: #f3f4f6; color: var(--text-sub); font-size: 30rpx; font-weight: 500; height: 88rpx; line-height: 88rpx; border-radius: 44rpx;">清除重写</button>
      <button class="hover-scale" bindtap="saveSignature" style="width: 45%; margin: 0; background: linear-gradient(135deg, var(--primary-color), var(--primary-dark)); color: #fff; font-size: 30rpx; font-weight: bold; height: 88rpx; line-height: 88rpx; border-radius: 44rpx; box-shadow: 0 8rpx 16rpx rgba(22,119,255,0.2);">保存签名</button>
    </view>
  </view>
</view>
<danger-btn />
