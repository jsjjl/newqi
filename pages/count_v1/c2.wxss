.ant{ width: 90%; height: auto; display: block; float: left; margin: 20rpx 5% 20rpx; padding: 20rpx 30rpx; box-sizing: border-box;border: 1px solid #1677ff; border-radius: 20rpx;}
.antl{ width: 60rpx; height: 60rpx; display: block; float: left; margin: 10rpx 0 0 0;}
.ant span{ width: auto; height: 80rpx; line-height: 80rpx; margin: 0 0 0 20rpx; display: block; float: left;}
.antr{ width: 50rpx; height: 50rpx; display: block; float: right; margin: 15rpx 0rpx 0 0; opacity: .5;}


