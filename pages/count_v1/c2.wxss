.title{ width: 100%; height: auto; display: block; float: left; margin: 20rpx 0 10rpx; padding:0 30rpx; box-sizing: border-box;}
.title image{ width: 67rpx; height: 67rpx; display: block; float: left; margin: 0 20rpx 0 0;}
.title  span{ width: auto; height: auto; display: block; float: left; line-height: 67rpx; font-size: 27rpx; color: #2f2f2f;}

.tab{width: 100%; height: auto; display: block; float: left; margin: 10rpx 0 20rpx; padding:0 30rpx; box-sizing: border-box;}
.tab span{ font-size: 24rpx; margin:  0 0 0 20rpx; color: #2f2f2f;}
.tab span.active{ color: #1677ff; font-size: 28rpx;}
