<view class="page">
  <!-- 点位基本信息及今日统计 -->
  <view class="header-card">
    <view class="point-title">
      <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/map.png" class="icon-map" />
      <text class="point-name">{{pointName || '加载中...'}}</text>
    </view>
    <view class="stats">
      <view class="stat-item">
        <text class="stat-num">{{todayCount}}</text>
        <text class="stat-label">今日巡检次数</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">{{totalCount}}</text>
        <text class="stat-label">历史总巡检</text>
      </view>
    </view>
  </view>

  <!-- 历史巡检记录列表 -->
  <view class="section-title">
    <view class="line"></view>
    <text>最近历史巡检记录</text>
  </view>
  
  <view class="records-list">
    <block wx:for="{{records}}" wx:key="index">
      <view class="record-card" bindtap="toDetail" data-pointid="{{item.pointId}}" data-taskid="{{item.taskId}}">
        <view class="record-header">
          <view class="record-status {{item.state == 1 ? 'status-ok' : 'status-err'}}">
            {{item.state == 1 ? '正常' : '异常'}}
          </view>
          <text class="record-time">{{item.submitTime}}</text>
        </view>
        <view class="record-content">
          <view class="info-row">
            <text class="info-label">巡检人员：</text>
            <text class="info-value">{{item.submitterName || '未知'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">巡检周期：</text>
            <text class="info-value">{{item.cycle || '-'}}</text>
          </view>
        </view>
        <view class="record-footer">
          <text>查看详情与照片</text>
          <text class="arrow">></text>
        </view>
      </view>
    </block>

    <view wx:if="{{records.length === 0 && !loading}}" class="no-data">
      <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/no.png" mode="widthFix" class="no-img" />
      <text>暂无历史巡检记录</text>
    </view>
  </view>

  <!-- 底部悬浮按钮：发起新巡检 -->
  <view class="footer-btn-area">
    <view class="btn-start" bindtap="startInspection">
      <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/new/s3_1.svg" class="btn-icon" />
      <text>立即开始巡检</text>
    </view>
  </view>
</view>
<danger-btn />