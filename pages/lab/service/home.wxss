.xy_l{
    width:200rpx;
    height: 100vh;
    position: fixed;
    top: 0;
    left: 0;
    background: #ececec;
    z-index: 999;
    overflow: auto;
}
.xy_l .span{
    width: 100%;
    height:100rpx;
    line-height: 100rpx;
    display: block;
    float: left;
    box-sizing: border-box;
    padding:0 0rpx 0 20rpx;
    color: #333333;
    font-size: 28rpx;
    /* border-left: 10rpx solid #ececec; */
    border-radius: 0 20rpx 20rpx 0;
    position: relative;
}
.xy_l .span.active{   height:160rpx;
    line-height: 160rpx;
    background: #fff;
    /* border-left: 10rpx solid #fff;  */
    border-radius: 0 0 0 0;
    font-weight: bold;
}

.xy_l .bjt{
    width: 100%;
    height: 30rpx;
    border-radius: 0 0 30rpx 0;
    background: #ececec;
    position: absolute;
    top: 0rpx;
    left: 0;
    z-index: 3;
}

/* .xy_l .span:first-child{
    height:130rpx;
    line-height: 100rpx;
} */

.xy_l .span:first-child.active{   height:140rpx;
    line-height: 110rpx;
    background: #fff;

    border-radius: 0 0 0 0;
}


.xy_l .span:first-child .bjt{
    display: none;
}

.xy_l .bjf{
    width: 100%;
    height: 30rpx;
    border-radius: 0 30rpx 0  0;
    background: #ececec;
    position: absolute;
    bottom: 0rpx;
    left: 0; z-index: 3;
}
.xy_postbox{
    width: 100%;
    margin: 0 0 20rpx;
    padding: 0;
}

.xy_postbox_rimg{
width: 180rpx;
height: 180rpx;
display: block;
float: left;
border-radius: 20rpx;
}
.xy_postbox_rbox{
    width: 55%;
    line-height: 40rpx;

}

.xy_r{
    width: 550rpx;
    height: 100vh;
    position: fixed;
    top: 0;
    right: 0;
    overflow: auto;
    background: #fff;
    z-index: 999;
    box-sizing: border-box;
    padding: 20rpx 20rpx;
}
.xy_postbox_t{
    width: 100%;
    height:180rpx;
    position: relative;
}

.xy_postbox_t1{
    width: 100%;
    height: auto;
    display: block;
    float: left;
    font-weight: bold;
    font-size: 30rpx;
}

.xy_postbox_t2{
    width: 100%;
    height: auto;
    display: block;
    float: left;
    margin: 10rpx 0 0 0;
    font-size:25rpx;
    /* position: absolute;
    bottom:10rpx;
    right: 0; */
    color: #9e9e9e;
    text-align: left;
}
