<view wx:if="{{myxx}}" style="padding: 20rpx; padding-bottom: 200rpx; background: var(--bg-color); min-height: 100vh;">
  <view class="modern-card" style="margin-bottom: 20rpx; padding: 30rpx;">
    <view class="top flex-between" style="display: flex; align-items: center;">
      <image class="" src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/map.png" mode="widthFix" style="width: 32rpx; height: 32rpx; margin-right: 12rpx;" />
      <p style="font-size: 32rpx; font-weight: bold; color: var(--text-main); flex: 1;">点位: {{name}}</p>
    </view>
  </view>

  <view class="modern-card" style="padding: 10rpx 30rpx;">
    <block wx:for='{{entries_list}}' wx:key='index' wx:for-item='item'>
      <view class="{{'topb'}}" style="border-bottom: 1rpx solid var(--border-color); padding: 30rpx 0; position: relative;">
        <image class="" src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/del.png" mode="widthFix" bindtap="delChange" data-index="{{index}}" style="width: 36rpx; height: 36rpx; position: absolute; top: 34rpx; left: 0;" />
        <p style="font-size: 30rpx; color: var(--text-main); padding-left: 50rpx; display: block; margin-bottom: 20rpx;">
          {{item.entryName}}
        </p>
        <!-- type=2 正常/异常单选 -->
        <radio-group name="radio" wx:if="{{item.type==2 }}" bindchange="switch1Change" data-index="{{index}}" class="sw" style="display: flex; gap: 20rpx; padding-left: 50rpx;">
          <label class="swb" style="display: flex; align-items: center; font-size: 28rpx;">
            <radio value="1" checked="{{item.state==1}}" color="#1568EA" style="transform:scale(0.8);" />正常
          </label>
          <label class="swb err" style="display: flex; align-items: center; font-size: 28rpx; color: #ef4444;">
            <radio value="2" checked="{{item.state==2}}" class="err" color="#ef4444" style="transform:scale(0.8);" />异常
          </label>
        </radio-group>
        <radio-group name="radio" wx:if="{{item.type==3}}" bindchange="switch1Change" data-index="{{index}}" class="sw" style="display: flex; gap: 20rpx; padding-left: 50rpx;">
          <label class="swb" style="display: flex; align-items: center; font-size: 28rpx;">
            <radio value="1" checked="{{item.state==1}}" color="#1568EA" style="transform:scale(0.8);" />左
          </label>
          <label class="swb" style="display: flex; align-items: center; font-size: 28rpx;">
            <radio value="2" checked="{{item.state==2}}" color="#1568EA" style="transform:scale(0.8);" />右
          </label>
        </radio-group>
        <!-- type=1 显示输入框 -->
        <view class="input-wrap" wx:if="{{item.type==1}}" style="padding-left: 50rpx; display: flex; align-items: center;">
          <input class="input-value" placeholder="请输入具体数值" value="{{item.value || ''}}" data-index="{{index}}" bindinput="onEntryValueInput" style="flex: 1; border-bottom: 1rpx solid #e5e7eb; padding: 10rpx; font-size: 28rpx; margin-right: 16rpx;" />
          <span wx:if="{{item.unitName}}" style="color: var(--text-sub); font-size: 28rpx;">{{item.unitName?item.unitName:''}}</span>
        </view>

        <span class="hdx" wx:if="{{item.entryContent}}" style="display: block; padding-left: 50rpx; color: #ef4444; font-size: 26rpx; margin-top: 16rpx;">
          {{item.entryContent}}
        </span>
      </view>
    </block>
  </view>

  <view class="modern-card" style="margin-top: 20rpx; padding: 30rpx;">
    <view class="bz">
      <p style="font-size: 30rpx; font-weight: 500; color: var(--text-main); margin-bottom: 16rpx; display: block;">备注说明</p>
      <textarea bindblur="bindTextAreaBlur" class="bzb" placeholder="请输入备注信息..." style="width: 100%; height: 160rpx; background: #f9fafb; padding: 20rpx; border-radius: 12rpx; font-size: 28rpx; box-sizing: border-box;" />
    </view>
  </view>

  <view class="modern-card" style="margin-top: 20rpx; padding: 30rpx;">
    <view class="title" style="margin-bottom: 20rpx;">
      <p style="font-size: 30rpx; font-weight: 500; color: var(--text-main);">现场拍照</p>
    </view>
    <view class="tp" style="display: flex; flex-wrap: wrap;">
      <block wx:for='{{img_arr}}' wx:key='index' wx:for-item='item'>
        <view class="tpt" style="width: 150rpx; height: 150rpx; margin-right: 20rpx; margin-bottom: 20rpx; position: relative;">
          <image class="tptimg" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImg" bindlongpress="deleteImg" style="width: 100%; height: 100%; border-radius: 12rpx;"></image>
          <image class="del" src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/d.png" bindtap="deleteImg" data-id="{{item}}" mode="aspectFill" style="position: absolute; top: -12rpx; right: -12rpx; width: 40rpx; height: 40rpx;"></image>
        </view>
      </block>
      <view class="tpadd" bindtap="addimg" style="width: 150rpx; height: 150rpx; background: #f9fafb; border: 2rpx dashed #d1d5db; border-radius: 12rpx; display: flex; flex-direction: column; justify-content: center; align-items: center; margin-bottom: 20rpx;">
        <p style="font-size: 40rpx; color: #9ca3af; line-height: 1;">+</p>
        <span style="font-size: 24rpx; color: #9ca3af; margin-top: 8rpx;">添加照片</span>
      </view>
    </view>
  </view>

  <view class="modern-card" style="margin-top: 20rpx; padding: 30rpx; margin-bottom: 40rpx;">
    <view class="title" style="margin-bottom: 20rpx;">
      <p style="font-size: 30rpx; font-weight: 500; color: var(--text-main);">语音描述 (选填)</p>
    </view>
    <view class="ly">
      <view class="editWrapBox" style="padding: 0;width: 100%; margin: 0; box-shadow: none;">
        <block wx:if="{{noRecordShow}}">
          <view class="ks hover-scale" bindtap="authorize" style="background: #e0e7ff; color: #1e40af; border-radius: 40rpx; padding: 20rpx; text-align: center; font-size: 28rpx; display: flex; justify-content: center; align-items: center;">
            <p>点击开始录音</p>
          </view>
        </block>
        <block wx:if="{{recordLuzhiShow}}">
          <view class="ks hover-scale" bindtap="stopRecordAudio" style="background: #fee2e2; color: #dc2626; border-radius: 40rpx; padding: 20rpx; text-align: center; font-size: 28rpx; display: flex; justify-content: center; align-items: center;">
            <p>录音中（{{countNume}}s） 点击停止</p>
          </view>
        </block>
        <view wx:if="{{playAudioShow}}">
          <view class="bft" style="background: #d1fae5; color: #059669; border-radius: 40rpx; padding: 20rpx; text-align: center; font-size: 28rpx; display: flex; justify-content: center; align-items: center;">
            <p>播放中...</p>
          </view>
        </view>
        <block wx:if="{{finishRecordShow}}">
          <view class="bft" style="background: #f3f4f6; border-radius: 40rpx; padding: 20rpx; display: flex; justify-content: center; align-items: center; gap: 20rpx;">
            <view bindtap="playRecordAudio" data-type="1" style="display: flex; align-items: center; color: var(--primary-color); font-size: 28rpx;">
              <p>点击播放录音</p>
            </view>
            <image class="bftd" src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/d.png" mode="aspectFill" bindtap="recycleRecordAudio" style="width: 40rpx; height: 40rpx; padding: 10rpx;"></image>
          </view>
        </block>
      </view>
    </view>
  </view>

  <view style="position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 30rpx; background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05); z-index: 100; display: flex; gap: 20rpx;">
    <block wx:if="{{ywt}}">
      <view class="modern-btn hover-scale" bindtap="save" data-id="1" style="flex: 1; background: #fff; color: var(--primary-color); border: 2rpx solid var(--primary-color);">现场整改</view>
    </block>
    <view class="modern-btn hover-scale" bindtap="save" style="flex: 1;">
      <block wx:if="{{ywt}}">上报整改</block>
      <block wx:else>提交巡检</block>
    </view>
  </view>
</view>

<view wx:if="{{!myxx}}" style="text-align:center; padding-top: 200rpx; background: var(--bg-color); min-height: 100vh;">
  <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/no.png" style="width: 300rpx;" mode="widthFix" />
  <view style="margin-top: 30rpx; color: #666; font-size: 32rpx;">未查询到设备</view>
  <view class="modern-btn hover-scale" style="margin: 100rpx 60rpx 0;" bindtap="toAddPoint">新增点位信息</view>
</view>
<danger-btn />
