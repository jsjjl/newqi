<view class="page">
     <view class="search" style="margin-bottom: 20rpx;">
        <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/2/search.png" mode="widthFix" />
        <input model:value="{{name}}" bindinput="bindKeyInput" placeholder="输入设备名称" type="text" />
    </view>
    <view class="xy_postbox right" bindtap="go" data-id="{{item.url}}" wx:for="{{ list }}" wx:key="index">
        <view class="xy_postbox_t">
            <p>{{item.info}}</p>
            <span class="r" wx:if="{{item.alarmLevel}}">{{item.alarmLevel}}级告警</span>
        </view>
        <view class="xy_postbox_f">
            <p>
                <span>{{item.position?item.position:''}}</span>
                <span>{{item.person?item.person:''}}</span>
                <span>{{item.phone?item.phone:''}}</span>
            </p>
            <em><image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/new/time.svg" class="ic_time" mode="aspectFill"></image>{{item.alarmTime}}</em>
        </view>
    </view>
                <view class="no" wx:if="{{noData}}">
  <image src="https://medicalgas.lygyy.com.cn/minio/mg-image/wximg/images/no.png" class="no_img" mode="widthFix"/>
  <p>暂无数据</p>
</view>

    <!--<view class="noMor" wx:if="{{noMor}}">加载完成</view>-->
</view>
<danger-btn />
