.page {
  padding: 30rpx;
  background: #f5f6f8;
  min-height: 100vh;
}

.form-group {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
}

.label {
  width: 140rpx;
  font-size: 30rpx;
  color: #333;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.btn-submit {
  margin-top: 80rpx;
  background: #1568EA;
  color: #fff;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 40rpx;
  font-size: 32rpx;
}