/* 定义一个名为 "grow" 的关键帧动画 
  animation-name: fadeInleft;
  animation-duration: 0.7s;
*/
@keyframes grow {
  0% {
    /* 动画开始时，元素的大小 */
    transform: scale(0.1);
    opacity: 0.1;
  }
  100% {
    /* 动画结束时，元素的大小 */
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes move-up {
  0% {
    transform: translateY(300px);
  }
  100% {
    transform: translateY(0);
  }
}
.el-image-viewer__wrapper {
  animation: grow 0.3s ease-out;
}

@keyframes move-down {
  0% {
    transform: translateY(-300px);
  }
  100% {
    transform: translateY(0);
  }
}
.el-image-viewer__wrapper {
  animation: grow 0.3s ease-out;
}

@keyframes move {
  0% {
    transform: scale(1);
  }
  100% {
    transform: scale(1.1);
  }
}
@keyframes move_not {
  0% {
    transform: scale(1.1);
  }
  100% {
    transform: scale(1);
  }
}

@keyframes fadeInleft {
  0% {
    opacity: 0;
    transform: translateX(-500px);
  }

  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes fadeInright {
  0% {
    opacity: 0;
    transform: translateX(500px);
  }

  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes fadeInCenter {
  0% {
    opacity: 0;

  }

  100% {
    opacity: 1;

  }
}
@keyframes bjIn {
  0% {
    background-size: 150% 150%;
    background-position: 0 -500px;

  }

  100% {
    background-position: 0 0;
 
  }
}

